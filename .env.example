# Optional alternative to the first-run wizard (/setup) and Admin -> Impostazioni.
# Saved application settings override these defaults. This file is documentation, not loaded automatically.
HOST=127.0.0.1
PORT=13410
DATA_DIR=./data
PUBLIC_URL=
OUTPUT_PUBLIC_URL=
TRUST_PROXY=0
DISCORD_CLIENT_ID=
DISCORD_LOGIN_ENABLED=1
DISCORD_CLIENT_SECRET=
# Optional membership and role checks; comma-separated Discord role IDs.
DISCORD_GUILD_ID=
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_OPERATOR_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
# Identify hosting providers, countries and applicable international-transfer safeguards.
PRIVACY_HOSTING_REGION=
PRIVACY_POLICY_VERSION=2026-10-22
PRIVACY_REVIEWED=0
PARTICIPANT_RETENTION_DAYS=30
PARTICIPANT_MIN_AGE=18
AUDIENCE_VOTE_SECONDS=30
# Separate optional bot integration, disabled by default. Never use a user's OAuth token here.
DISCORD_ANNOUNCEMENTS_ENABLED=0
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
